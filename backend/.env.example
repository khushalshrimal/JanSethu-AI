# JanSethu AI 2.0 — Environment Configuration Blueprint

# Application Environment (development, test, production)
APP_ENV=development
DEBUG=true

# Core Security Secrets (CRITICAL: Change SECRET_KEY & WEBHOOK_SECRET in production!)
SECRET_KEY=generate_a_random_64_byte_hex_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
WEBHOOK_SECRET=generate_a_strong_random_webhook_secret_here

# Public Domain Base URL (Used for generating callback/webhook URLs)
PUBLIC_BASE_URL=http://localhost:8000

# CORS Allowed Origins (Comma-separated list of trusted origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://jansethu.example.com

# Database Connection URL
# Development: sqlite:///./jansethu_v2.db
# Production: postgresql://user:password@localhost:5432/jansethudb
DATABASE_URL=sqlite:///./jansethu_v2.db

# Rate Limiting (Requests per minute per IP address for sensitive routes)
RATE_LIMIT_PER_MINUTE=60

# Telephony Provider Selection (development, exotel, twilio)
TELEPHONY_PROVIDER=development

# Twilio Telephony Credentials
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18005550199

# Exotel Telephony Credentials (Indian Telecom IVR/ExoML)
EXOTEL_ACCOUNT_SID=your_exotel_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=+918000000000

# SMS Provider Selection (development, msg91, twilio)
SMS_PROVIDER=development

# MSG91 SMS Credentials (Indian DLT Routes)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=JANSTH
MSG91_TEMPLATE_ID=your_dlt_template_id_here

